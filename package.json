{
	"name": "factorio-blueprint-playground",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"dev:pages": "wrangler pages dev --proxy=5713 --port=8788",
		"dev:functions": "wrangler pages dev . --port=8788",
		"preview": "wrangler pages dev dist --port 5174",
		"generate:routes": "tsr generate",
		"generate:mod-db": "tsx scripts/mod-db/build-mod-db.ts",
		"generate:game-ui-spec": "tsx scripts/game-ui-spec/build-game-ui-spec.ts",
		"update:mod-db-sources": "tsx scripts/mod-db/update-source-lock.ts",
		"corpus:fetch": "scripts/corpus/fetch-top-blueprints.sh",
		"corpus:browser-check": "tsx scripts/corpus/browser-check.ts",
		"build": "pnpm run generate:routes && tsgo && vp build && wrangler pages functions build",
		"build:types": "pnpm run generate:routes && tsgo --noEmit --project tsconfig.routes.json",
		"lint:fix": "vp lint . --fix",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "pnpm run generate:routes && tsgo --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"test:run": "node node_modules/vitest/dist/cli.js run --project unit",
		"test:coverage": "node node_modules/vitest/dist/cli.js run --coverage",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:storybook": "node node_modules/vitest/dist/cli.js run --project storybook",
		"visual-conformance": "tsx scripts/visual-conformance/capture.ts",
		"visual-conformance:references": "tsx scripts/visual-conformance/validate-references.ts",
		"visual-conformance:smoke": "tsx scripts/visual-conformance/deployment-smoke.ts",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies": {
		"@sentry/react": "^11.8.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"date-fns": "^4.4.0",
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"fflate": "^0.8.3",
		"json5": "^2.2.3",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-error-boundary": "^6.1.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@cloudflare/workers-types": "^5.20261022.1",
		"@playwright/test": "1.63.0",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-onboarding": "^10.6.3",
		"@storybook/addon-vitest": "^10.6.3",
		"@storybook/react-vite": "^10.6.3",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-cli": "^1.167.33",
		"@tanstack/router-plugin": "^1.168.35",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-plugin-storybook": "^10.6.3",
		"fake-indexeddb": "^6.2.5",
		"fallow": "^3.35.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.24.0",
		"pixelmatch": "^8.0.0",
		"playwright": "1.63.0",
		"pngjs": "^7.0.0",
		"sharp": "^0.35.5",
		"storybook": "^10.6.3",
		"tsx": "^4.23.15",
		"typescript": "~7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.151.3"
	},
	"packageManager": "pnpm@11.15.0"
}
