{
	"name": "factorio-blueprint-playground",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"dev:pages": "wrangler pages dev --proxy=5173 --port=8788",
		"dev:functions": "wrangler pages dev . --port=8788",
		"preview": "wrangler pages dev dist --port 5174",
		"generate:routes": "tsr generate",
		"generate:mod-db": "tsx scripts/mod-db/build-mod-db.ts",
		"update:mod-db-sources": "tsx scripts/mod-db/update-source-lock.ts",
		"build": "pnpm run generate:routes && tsgo && vp build && wrangler pages functions build",
		"build:types": "pnpm run generate:routes && tsgo --noEmit --project tsconfig.routes.json",
		"oxlint": "vp lint . --fix",
		"lint:fix": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "pnpm run generate:routes && tsgo --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"test:run": "node node_modules/vitest/dist/cli.js run",
		"test:coverage": "node node_modules/vitest/dist/cli.js run --coverage",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepare": "vp config"
	},
	"dependencies": {
		"@sentry/react": "^10.69.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-router": "^1.170.20",
		"date-fns": "^4.4.0",
		"dexie": "^4.4.4",
		"dexie-react-hooks": "^4.4.0",
		"fflate": "^0.8.3",
		"json5": "^2.2.3",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.0",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.6",
		"@storybook/addon-docs": "^10.5.6",
		"@storybook/addon-onboarding": "^10.5.6",
		"@storybook/addon-vitest": "^10.5.6",
		"@storybook/react-vite": "^10.5.6",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-cli": "^1.167.23",
		"@tanstack/router-plugin": "^1.168.25",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-plugin-storybook": "^10.5.6",
		"fallow": "^3.14.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.2",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"sharp": "^0.35.3",
		"storybook": "^10.5.6",
		"tsx": "^4.23.10",
		"typescript": "~7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.119.0"
	},
	"packageManager": "pnpm@11.15.0"
}
